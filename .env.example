# Local single-user mode. Keep this file private after copying to .env.
# Defaults: nebius, tavily, sec. Uncomment all three lines to run with fixtures.
# MODEL_PROVIDER=mock
# SEARCH_PROVIDER=mock
# FINANCIAL_DATA_PROVIDER=mock
NEBIUS_API_KEY=
NEBIUS_MODEL=zai-org/GLM-5.3-Flash
TAVILY_API_KEY=
SEC_CONTACT_EMAIL=

# Per-task resource limits.
MAX_SEARCH_ROUNDS=2
MAX_SEARCH_QUERIES=12
MAX_MODEL_CALLS=6
REQUEST_TIMEOUT_SECONDS=240

# Optional private storage locations.
SELDON_DATA_DIR=
SELDON_SETTINGS_FILE=

# News generation only. GLM-5.3-Flash requests up to 6144.
# NEWS_MAX_OUTPUT_TOKENS=6144
